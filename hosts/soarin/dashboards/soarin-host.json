{
  "uid": "soarin-host",
  "title": "soarin host",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed units",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(node_systemd_unit_state{job=\"node\",state=\"failed\"} == 1) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{job=\"node\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU by systemd unit (100% = one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, label_replace(label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",cpu=\"total\",id=~`/system\\.slice/[^/]+\\.service|/machine\\.slice/libpod-[^/]+\\.scope|/user\\.slice`}[5m]), \"unit\", \"$1\", \"id\", `.*/([^/]+?)(\\.service)?`), \"unit\", \"container $1\", \"id\", `.*/libpod-(.{12})[^/]*\\.scope`))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU by unit inside the UniFi container (100% = one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, label_replace(label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",cpu=\"total\",id=~`/machine\\.slice/libpod-[^/]+\\.scope/container/system\\.slice/.+\\.service`}[5m]), \"unit\", \"$1\", \"id\", `.*/([^/]+?)(\\.service)?`), \"unit\", \"container $1\", \"id\", `.*/libpod-(.{12})[^/]*\\.scope`))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Load average",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"node\"}",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "expr": "node_load5{job=\"node\"}",
          "legendFormat": "5m"
        },
        {
          "refId": "C",
          "expr": "node_load15{job=\"node\"}",
          "legendFormat": "15m"
        }
      ]
    },
    {
      "id": 8,
      "title": "Memory by systemd unit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, label_replace(container_memory_working_set_bytes{job=\"cadvisor\",id=~`/system\\.slice/[^/]+\\.service|/machine\\.slice/libpod-[^/]+\\.scope`}, \"unit\", \"$1\", \"id\", `.*/([^/]+?)(\\.service)?`))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Disk used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|overlay|squashfs|vfat|nsfs\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|overlay|squashfs|vfat|nsfs\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Disk I/O",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"node\"}[5m])",
          "legendFormat": "{{device}} read"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{job=\"node\"}[5m])",
          "legendFormat": "{{device}} write"
        }
      ]
    },
    {
      "id": 11,
      "title": "Network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{job=\"node\",device!~\"lo|veth.*|podman.*\"}[5m]) * 8",
          "legendFormat": "{{device}} in"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo|veth.*|podman.*\"}[5m]) * 8",
          "legendFormat": "{{device}} out"
        }
      ]
    }
  ]
}
